{
    "name": "webwizardsusa/filament-rich-editor-plus",
    "description": "A plugin-driven, TipTap based rich editor for Filament with a Gutenberg style block toolbar.",
    "keywords": [
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "tiptap",
        "rich-editor",
        "webwizardsusa"
    ],
    "homepage": "https://github.com/webwizardsusa/filament-rich-editor-plus",
    "support": {
        "issues": "https://github.com/webwizardsusa/filament-rich-editor-plus/issues",
        "source": "https://github.com/webwizardsusa/filament-rich-editor-plus"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jamie Holly",
            "email": "jamie@webwizardsusa.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "filament/filament": "^5.0",
        "league/commonmark": "^2.10.2",
        "postare/blade-mdi": "^1.1",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "Webwizardsusa\\RichEditorPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webwizardsusa\\RichEditorPlus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webwizardsusa\\RichEditorPlus\\RichEditorPlusServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "webwizardsusa/laravel-image-cache": "^0.1.0 || ^0.2.0"
    },
    "suggest": {
        "webwizardsusa/laravel-image-cache": "To store images as Image Cache Images shown in Image Styles, with ImagePlugin::imageCache()."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
