{
    "name": "webwizardsusa/rich-editor-plus",
    "description": "A plugin-driven, TipTap based rich editor for Filament with a Gutenberg style block toolbar.",
    "keywords": [
        "laravel",
        "filament",
        "tiptap",
        "rich-editor"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jamie Holly"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "filament/filament": "^5.0",
        "league/commonmark": "^2.10.2",
        "postare/blade-mdi": "^1.1",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "Webwizardsusa\\RichEditorPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webwizardsusa\\RichEditorPlus\\Tests\\": "tests/",
            "Webwizardsusa\\RichEditorPlus\\Benchmarks\\": "benchmarks/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webwizardsusa\\RichEditorPlus\\RichEditorPlusServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
