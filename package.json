{
    "name": "@hollyit/rich-editor-plus",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.js",
        "dev:table": "vite --config vite.modules.config.js --mode table",
        "dev:image": "vite --config vite.modules.config.js --mode image",
        "dev:markdown": "vite --config vite.modules.config.js --mode markdown",
        "build": "vite build --config vite.config.js && npm run build:table && npm run build:image && npm run build:markdown",
        "build:table": "vite build --config vite.modules.config.js --mode table",
        "build:image": "vite build --config vite.modules.config.js --mode image",
        "build:markdown": "vite build --config vite.modules.config.js --mode markdown",
        "test": "vitest run"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.0",
        "@tiptap/core": "^3.0.0",
        "@tiptap/extension-blockquote": "^3.0.0",
        "@tiptap/extension-bold": "^3.0.0",
        "@tiptap/extension-code": "^3.31.3",
        "@tiptap/extension-code-block": "^3.31.3",
        "@tiptap/extension-document": "^3.0.0",
        "@tiptap/extension-hard-break": "^3.0.0",
        "@tiptap/extension-heading": "^3.31.3",
        "@tiptap/extension-horizontal-rule": "^3.31.3",
        "@tiptap/extension-italic": "^3.0.0",
        "@tiptap/extension-link": "^3.0.0",
        "@tiptap/extension-list": "^3.31.3",
        "@tiptap/extension-paragraph": "^3.0.0",
        "@tiptap/extension-strike": "^3.0.0",
        "@tiptap/extension-subscript": "^3.31.3",
        "@tiptap/extension-superscript": "^3.31.3",
        "@tiptap/extension-table": "^3.0.0",
        "@tiptap/extension-text": "^3.0.0",
        "@tiptap/extension-underline": "^3.0.0",
        "@tiptap/extensions": "^3.0.0",
        "@tiptap/pm": "^3.0.0",
        "@tiptap/suggestion": "^3.31.3"
    },
    "devDependencies": {
        "jsdom": "^30.1.3",
        "vitest": "^5.0.5"
    }
}
