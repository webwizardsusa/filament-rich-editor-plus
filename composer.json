{
    "name": "hollyit/rich-editor-plus",
    "description": "A plugin-driven, TipTap based rich editor for Filament with a Gutenberg style block toolbar.",
    "keywords": [
        "laravel",
        "filament",
        "tiptap",
        "rich-editor"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "filament/filament": "^5.0",
        "postare/blade-mdi": "^1.1",
        "league/commonmark": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "Hollyit\\RichEditorPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hollyit\\RichEditorPlus\\Tests\\": "tests/",
            "Hollyit\\RichEditorPlus\\Benchmarks\\": "benchmarks/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hollyit\\RichEditorPlus\\RichEditorPlusServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
